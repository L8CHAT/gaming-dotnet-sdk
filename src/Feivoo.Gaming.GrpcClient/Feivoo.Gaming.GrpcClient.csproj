<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <AssemblyName>Feivoo.Gaming.GrpcClient</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Feivoo.Gaming.GrpcClient</PackageId>
    <Title>Feivoo Gaming gRPC Client SDK</Title>
    <Description>Feivoo Gaming .NET 客户端 SDK。基于 Vertex.Messaging + Vertex.Transport.Grpc 接入 Feivoo Gaming 平台，支持请求-响应、服务端推送事件、反向 RPC（订单/钱包查询）、自动重连（指数退避）及 DI 集成。v2.0.0 重写：wire 协议改为 Vertex 4-frame envelope。</Description>
    <PackageTags>grpc;gaming;feivoo;client;sdk;dotnet;vertex</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.71.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Vertex.Messaging" Version="1.0.1" />
    <PackageReference Include="Vertex.Transport.Grpc" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Feivoo.Gaming.Grpc\Feivoo.Gaming.Grpc.csproj" />
  </ItemGroup>

</Project>
