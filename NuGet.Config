<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Vertex.* (Vertex.Messaging / Vertex.Transport.Grpc / Vertex.Transport.NetMq)
         are published to dengxuan's GitHub Packages by vertex-dotnet's
         nupkg-publish.yml workflow. Local restore requires a PAT with
         read:packages; CI authenticates via VERTEX_NUGET_TOKEN secret
         (see .github/workflows/release.yml). -->
    <add key="vertex" value="https://nuget.pkg.github.com/dengxuan/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
